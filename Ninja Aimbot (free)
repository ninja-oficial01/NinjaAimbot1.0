})

-- ══ ESP POOL ══════════════════════════════
local espObjs = {}

local function buildESP(player)
    if player == LocalPlayer or espObjs[player] then return end
    local corners = {}
    for i = 1, 8 do
        corners[i] = newDraw("Line", {
            Visible=false,
            Color=Color3.fromRGB(255,255,255),
            Thickness=2,
            Transparency=1,
            ZIndex=5,
        })
    end
    espObjs[player] = {
        corners    = corners,
        name       = newDraw("Text", {
            Visible=false, Color=Color3.fromRGB(255,255,255),
            Size=13, Font=Drawing.Fonts.UI,
            Outline=true, OutlineColor=Color3.new(0,0,0),
            Center=true, ZIndex=6,
        }),
        healthBack = newDraw("Square", {
            Visible=false, Color=Color3.fromRGB(10,10,10),
            Transparency=1, Filled=true, Thickness=0, ZIndex=4,
        }),
        healthBar  = newDraw("Square", {
            Visible=false, Color=Color3.fromRGB(0,210,55),
            Transparency=1, Filled=true, Thickness=0, ZIndex=5,
        }),
    }
end

local function removeESP(player)
    local obj = espObjs[player]
    if not obj then return end
    if obj.corners then
        for _, l in ipairs(obj.corners) do
            pcall(function() if l then l.Visible=false; l:Remove() end end)
        end
    end
    for k, d in pairs(obj) do
        if k ~= "corners" then
            pcall(function() if d then d.Visible=false; d:Remove() end end)
        end
    end
    espObjs[player] = nil
end

Players.PlayerRemoving:Connect(removeESP)
Players.PlayerAdded:Connect(buildESP)
for _, p in ipairs(Players:GetPlayers()) do buildESP(p) end

local function hideESP(obj)
    if obj.corners then
        for _, l in ipairs(obj.corners) do
            pcall(function() if l then l.Visible=false end end)
        end
    end
    pcall(function() if obj.name       then obj.name.Visible=false       end end)
    pcall(function() if obj.healthBack then obj.healthBack.Visible=false end end)
    pcall(function() if obj.healthBar  then obj.healthBar.Visible=false  end end)
end

-- ══ CORNER DRAWER ═════════════════════════
local function updateCorners(obj, x, y, w, h)
    local lines = obj.corners
    if not lines then return end

    if not Config.ESPBox then
        for _, l in ipairs(lines) do
            pcall(function() if l then l.Visible=false end end)
        end
        return
    end

    local ax = w * 0.25
    local ay = h * 0.22

    local segs = {
        { Vector2.new(x,       y),       Vector2.new(x+ax,    y)       },
        { Vector2.new(x,       y),       Vector2.new(x,       y+ay)    },
        { Vector2.new(x+w,     y),       Vector2.new(x+w-ax,  y)       },
        { Vector2.new(x+w,     y),       Vector2.new(x+w,     y+ay)    },
        { Vector2.new(x,       y+h),     Vector2.new(x+ax,    y+h)     },
        { Vector2.new(x,       y+h),     Vector2.new(x,       y+h-ay)  },
        { Vector2.new(x+w,     y+h),     Vector2.new(x+w-ax,  y+h)     },
        { Vector2.new(x+w,     y+h),     Vector2.new(x+w,     y+h-ay)  },
    }

    for i, seg in ipairs(segs) do
        local l = lines[i]
        if l then
            pcall(function()
                l.From    = seg[1]
                l.To      = seg[2]
                l.Visible = true
            end)
        end
    end
end

-- ══ BOUNDING BOX ══════════════════════════
local CORNERS = {
    Vector3.new( 1.5, 3.2, 1.5), Vector3.new(-1.5, 3.2, 1.5),
    Vector3.new( 1.5, 3.2,-1.5), Vector3.new(-1.5, 3.2,-1.5),
    Vector3.new( 1.5,-3.0, 1.5), Vector3.new(-1.5,-3.0, 1.5),
    Vector3.new( 1.5,-3.0,-1.5), Vector3.new(-1.5,-3.0,-1.5),
}

-- ══ RAYCAST ═══════════════════════════════
local rayParams = RaycastParams.new()
rayParams.FilterType  = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function getTarget(maxDist, maxAngleDeg)
    local best, bestAngle = nil, maxAngleDeg
    local vpSize = Camera.ViewportSize
    local center = Vector2.new(vpSize.X/2, vpSize.Y/2)
    for _, enemy in ipairs(Players:GetPlayers()) do
        if enemy ~= LocalPlayer then
            pcall(function()
                local char = enemy.Character
                local head = char and char:FindFirstChild("Head")
                local hum  = char and char:FindFirstChildOfClass("Humanoid")
                if not head or not hum or hum.Health <= 0 then return end
                local dir  = head.Position - Camera.CFrame.Position
                if dir.Magnitude > maxDist then return end
                local sp, onScreen = Camera:WorldToViewportPoint(head.Position)
                if not onScreen then return end
                if (Vector2.new(sp.X,sp.Y)-center).Magnitude > Config.FOVSize*2 then return end
                local angle = math.deg(math.acos(
                    math.clamp(Camera.CFrame.LookVector:Dot(dir.Unit),-1,1)))
                if angle >= bestAngle then return end
                rayParams.FilterDescendantsInstances = {LocalPlayer.Character or {}, char}
                if not workspace:Raycast(Camera.CFrame.Position, dir, rayParams) then
                    best=head; bestAngle=angle
                end
            end)
        end
    end
    return best
end

