local function createDraw(kind, props)
	local ok, obj = pcall(function()
		return Drawing.new(kind)
	end)
	if not ok or not obj then
		return nil
	end
	for k, v in pairs(props) do
		pcall(function()
			obj[k] = v
		end)
	end
	return obj
end

