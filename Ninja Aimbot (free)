	Radius       = Config.FOVSize * 2,
	NumSides     = 64,
})

local espObjs = {}

local function buildESP(player)
	if not player or player == LocalPlayer or espObjs[player] then
		return
	end

	local fontId = 2
	pcall(function()
		if Drawing and Drawing.Fonts and Drawing.Fonts.UI then
			fontId = Drawing.Fonts.UI
		end
	end)

	espObjs[player] = {
		fill = createDraw("Square", {
			Visible      = false,
			Color        = CFG.FillColor,
			Transparency = CFG.FillAlpha,
			Filled       = true,
			Thickness    = 0,
			ZIndex       = 1,
		}),
		box = createDraw("Square", {
			Visible      = false,
			Color        = CFG.BoxColor,
			Transparency = 1,
			Filled       = false,
			Thickness    = CFG.BoxThick,
			ZIndex       = 2,
		}),
		name = createDraw("Text", {
			Visible      = false,
			Color        = CFG.NameColor,
			Size         = CFG.NameSize,
			Font         = fontId,
			Outline      = true,
			OutlineColor = Color3.fromRGB(0, 0, 0),
			Center       = true,
			ZIndex       = 3,
		}),
	}
end

local function removeESP(player)
	local obj = espObjs[player]
	if not obj then
		return
	end
	for _, d in pairs(obj) do
		if d then
			pcall(function()
				d.Visible = false
				d:Remove()
			end)
		end
	end
	espObjs[player] = nil
end

Players.PlayerRemoving:Connect(removeESP)
Players.PlayerAdded:Connect(buildESP)
for _, p in ipairs(Players:GetPlayers()) do
	buildESP(p)
end

local function hideObj(obj)
	if not obj then
		return
	end
	for _, d in pairs(obj) do
		if d then
			pcall(function()
				d.Visible = false
			end)
		end
	end
end

