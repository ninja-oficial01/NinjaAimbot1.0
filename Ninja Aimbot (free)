-- ══ RENDER LOOP ═══════════════════════════
RunService.RenderStepped:Connect(function()
    pcall(function()
        local vpCenter = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

        if FOVCircle then
            FOVCircle.Visible  = Config.ShowFOV
            FOVCircle.Position = vpCenter
            FOVCircle.Radius   = Config.FOVSize * 2
        end

        if Config.Aimbot then
            local h = getTarget(180, 30)
            if h then
                Camera.CFrame = Camera.CFrame:Lerp(
                    CFrame.lookAt(Camera.CFrame.Position, h.Position), 0.75)
            end
        end

        if Config.AimbotLegit and not isMovingCamera then
            local h = getTarget(150, 25)
            if h then
                Camera.CFrame = Camera.CFrame:Lerp(
                    CFrame.lookAt(Camera.CFrame.Position, h.Position), 0.35)
            end
        end

        for player, obj in pairs(espObjs) do
            local char = player.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local hum  = char and char:FindFirstChildOfClass("Humanoid")

            if not root or not hum or hum.Health <= 0 then
                hideESP(obj)
            else
                local minX, minY =  math.huge,  math.huge
                local maxX, maxY = -math.huge, -math.huge
                local allVis = true

                for _, offset in ipairs(CORNERS) do
                    local wp = root.CFrame:PointToWorldSpace(offset)
                    local sp, vis = Camera:WorldToViewportPoint(wp)
                    if not vis then allVis=false; break end
                    if sp.X < minX then minX=sp.X end
                    if sp.Y < minY then minY=sp.Y end
                    if sp.X > maxX then maxX=sp.X end
                    if sp.Y > maxY then maxY=sp.Y end
                end

                if not allVis then
                    hideESP(obj)
                else
                    local w = maxX - minX
                    local h = maxY - minY

                    updateCorners(obj, minX, minY, w, h)

                    if Config.ESPName and obj.name then
                        obj.name.Text     = player.DisplayName
                        obj.name.Position = Vector2.new(minX + w/2, minY - 18)
                        obj.name.Visible  = true
                    elseif obj.name then
                        obj.name.Visible = false
                    end

                    if Config.ESPHealth and hum.MaxHealth > 0 then
                        local pct  = math.clamp(hum.Health/hum.MaxHealth, 0, 1)
                        local barH = math.max(h * pct, 1)
                        local g = math.floor(130 + 80*pct)
                        if obj.healthBar then
                            obj.healthBar.Color = Color3.fromRGB(0, g, 40)
                        end
                        if obj.healthBack then
                            obj.healthBack.Position = Vector2.new(minX - 7, minY)
                            obj.healthBack.Size     = Vector2.new(4, h)
                            obj.healthBack.Visible  = true
                        end
                        if obj.healthBar then
                            obj.healthBar.Position = Vector2.new(minX - 6.5, minY + (h - barH))
                            obj.healthBar.Size     = Vector2.new(3, barH)
                            obj.healthBar.Visible  = true
                        end
                    else
                        if obj.healthBack then obj.healthBack.Visible=false end
                        if obj.healthBar  then obj.healthBar.Visible=false  end
                    end
                end
            end
        end
    end)
end)

