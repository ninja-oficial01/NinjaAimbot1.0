local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
rayParams.IgnoreWater = true

local function isInVehicle(humanoid, rootPart)
	if humanoid and humanoid.SeatPart then
		return true
	end
	if rootPart then
		for _, child in ipairs(rootPart:GetChildren()) do
			if child:IsA("Weld") and child.Part1 then
				local pName = child.Part1.Name:lower()
				local parentName = child.Part1.Parent and child.Part1.Parent.Name:lower() or ""
				if pName:find("seat") or parentName:find("car") or parentName:find("vehicle") then
					return true
				end
			end
		end
	end
	return false
end

local function getClosestTarget(cam, maxDist, maxAngle)
	if not cam then
		return nil
	end

	local selected = nil
	local smallestAngle = maxAngle
	local vp = cam.ViewportSize
	local center = Vector2.new(vp.X / 2, vp.Y / 2)
	local fovRadius = Config.FOVSize * 2

	for _, enemy in ipairs(Players:GetPlayers()) do
		if enemy ~= LocalPlayer then
			local character = enemy.Character
			local head = character and character:FindFirstChild("Head")
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")

			if head and humanoid and humanoid.Health > 0 and rootPart and not isInVehicle(humanoid, rootPart) then
				local direction = head.Position - cam.CFrame.Position
				local distance = direction.Magnitude
				local sp, onScreen = cam:WorldToViewportPoint(head.Position)

				if onScreen and distance <= maxDist and distance > 0.1 then
					if (Vector2.new(sp.X, sp.Y) - center).Magnitude <= fovRadius then
						local angle = math.deg(math.acos(math.clamp(
							cam.CFrame.LookVector:Dot(direction.Unit),
							-1, 1
						)))

						local ignore = {}
						if LocalPlayer.Character then
							table.insert(ignore, LocalPlayer.Character)
						end
						table.insert(ignore, character)
						rayParams.FilterDescendantsInstances = ignore

						local hit = workspace:Raycast(cam.CFrame.Position, direction, rayParams)
						if not hit and angle < smallestAngle then
							smallestAngle = angle
							selected = head
						end
					end
				end
			end
		end
	end

	return selected
end

RunService.RenderStepped:Connect(function()
	pcall(function()
		local cam = workspace.CurrentCamera
		if not cam then
			return
		end

		if FOVCircle then
			if Config.ShowFOV then
				FOVCircle.Visible = true
				FOVCircle.Position = Vector2.new(cam.ViewportSize.X / 2, cam.ViewportSize.Y / 2)
				FOVCircle.Radius = Config.FOVSize * 2
			else
				FOVCircle.Visible = false
			end
		end

		if Config.Aimbot then
			local targetHead = getClosestTarget(cam, 180, 30)
			if targetHead then
				local goalCFrame = CFrame.lookAt(cam.CFrame.Position, targetHead.Position)
				cam.CFrame = cam.CFrame:Lerp(goalCFrame, 0.75)
			end
		elseif Config.AimbotLegit and not isMovingCamera then
			local targetHead = getClosestTarget(cam, 150, 25)
			if targetHead then
				local goalCFrame = CFrame.lookAt(cam.CFrame.Position, targetHead.Position)
				cam.CFrame = cam.CFrame:Lerp(goalCFrame, 0.35)
			end
		end

		for player, obj in pairs(espObjs) do
			local char = player.Character
			local root = char and char:FindFirstChild("HumanoidRootPart")
			local head = char and char:FindFirstChild("Head")
			local hum  = char and char:FindFirstChildOfClass("Humanoid")

			if not root or not head or not hum or hum.Health <= 0 then
				hideObj(obj)
			else
				local headPos, headVis = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 0.55, 0))
				local footPos, footVis = cam:WorldToViewportPoint(root.Position - Vector3.new(0, 2.85, 0))

				if headPos.Z <= 0.1 or (not headVis and not footVis) then
					hideObj(obj)
				else
					local dist = (root.Position - cam.CFrame.Position).Magnitude
					local distScale = math.clamp(1 - (dist / 450), 0.76, 1)

					local topY = math.min(headPos.Y, footPos.Y)
					local botY = math.max(headPos.Y, footPos.Y)
					local rawH = math.max(botY - topY, 8)
					local h = math.clamp(rawH * distScale, 8, cam.ViewportSize.Y * 0.85)
					local w = math.max(h * 0.52, 6)
					local x = headPos.X - w / 2
					local y = topY + (rawH - h) * 0.5

					if Config.ESPName and obj.name then
						pcall(function()
							obj.name.Size = CFG.NameSize
							obj.name.Text = player.DisplayName
							obj.name.Position = Vector2.new(headPos.X, y - CFG.NameSize - 5)
							obj.name.Visible = true
						end)
					elseif obj.name then
						pcall(function() obj.name.Visible = false end)
					end

					if Config.ESPBox then
						if obj.fill then
							pcall(function()
								obj.fill.Position = Vector2.new(x, y)
								obj.fill.Size     = Vector2.new(w, h)
								obj.fill.Visible  = true
							end)
						end
						if obj.box then
							pcall(function()
								obj.box.Position  = Vector2.new(x, y)
								obj.box.Size      = Vector2.new(w, h)
								obj.box.Visible   = true
							end)
						end
					else
						if obj.fill then pcall(function() obj.fill.Visible = false end) end
						if obj.box  then pcall(function() obj.box.Visible  = false end) end
					end
				end
			end
		end
	end)
end)

